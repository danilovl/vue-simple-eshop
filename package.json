{
  "name": "vue-simple-eshop",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "start-server-and-test preview http://localhost:4173/ '../cypress open --e2e'",
    "test:e2e:ci": "start-server-and-test preview http://localhost:4173/ '../cypress run --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "lint": "eslint . --fix",
    "json": "json-server data.js --host 0.0.0.0 -p 3500 -m authMiddleware.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.0",
    "@fortawesome/free-regular-svg-icons": "^6.7.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@popperjs/core": "^2.11.8",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.13.6",
    "bootstrap": "^5.3.8",
    "core-js": "^3.49.0",
    "@faker-js/faker": "^10.3.0",
    "json-server": "^0.17.4",
    "jsonwebtoken": "^9.0.3",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.30",
    "vue-awesome-paginate": "^1.2.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.1.0",
    "eslint-plugin-cypress": "^6.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.7.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  }
}